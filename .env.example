# ==============================================================================
# CRAFTWARE ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your verified project credentials.
# ==============================================================================

# --- SUPABASE (Database, Auth, Row-Level Security) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- PUBLIC BRAND & CLIENT TELEMETRY ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="CRAFTWARE Systems"
NEXT_PUBLIC_CONTACT_EMAIL="procurement@craftware.com"
NEXT_PUBLIC_CONTACT_PHONE="+1 (555) 019-2834"
NEXT_PUBLIC_CONTACT_WHATSAPP="15550192834"
NEXT_PUBLIC_CONTACT_ADDRESS="450 Technology Parkway, Suite 800, Austin, TX 78701"
NEXT_PUBLIC_CONTACT_HOURS="Mon - Fri: 08:00 - 18:00 EST"

# Backward compatibility aliases
NEXT_PUBLIC_WHATSAPP_NUMBER="15550192834"
NEXT_PUBLIC_BUSINESS_PHONE="+1 (555) 019-2834"

# --- SERVER-ONLY SECRETS (Do NOT prefix with NEXT_PUBLIC_) ---
# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Resend API credentials for email dispatch (https://resend.com/api-keys)
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM_EMAIL="CRAFTWARE <onboarding@resend.dev>"
BUSINESS_EMAIL="inbox@craftware.com"

# Authorized Admin Console access (comma-separated for multiple admins)
ADMIN_EMAILS="admin@craftware.com,ops@craftware.com"